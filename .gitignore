.venv/
__pycache__/
*.pyc
.DS_Store
# Ignore the entire data dir — it holds runtime SQLite DBs, DB backups,
# personal CSVs, and uploaded bank statements. The app recreates data/ on
# startup (DATA_DIR.mkdir), so nothing here needs to be tracked.
data/
.env
.env.local

# Personal Claude Code overrides (permission allowlists etc.) — not shared.
.claude/settings.local.json

# mobile/.env holds ONLY publishable client values (Supabase URL + anon key)
# that ship inside the app bundle by design — safe and needed for builds.
!mobile/.env
