# Copy to .env (gitignored) and fill in from the Supabase dashboard.
# Never commit real values.

# postgres = run on Supabase (auth + data); unset/sqlite = local SQLite mode.
VERMO_BACKEND=postgres

# Dashboard → Connect → "Transaction pooler" URI, with the database password.
# Needed by scripts/migrate_sqlite_to_postgres.py and (Stage 2) the backend.
DATABASE_URL=postgresql://postgres.oxsfgdhrdkhpyfmgmrhe:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Dashboard → Settings → API. The anon key is safe for clients (RLS enforces
# access); the service-role key is NOT — backend only, never in client code.
SUPABASE_URL=https://oxsfgdhrdkhpyfmgmrhe.supabase.co
SUPABASE_ANON_KEY=your-anon-key
